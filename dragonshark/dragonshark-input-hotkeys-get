#!/bin/bash
set -euo pipefail
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/retroarch/retroarch.cfg"

function get_button() {
    local key="$1"
    local val
    val="$(
        grep -E "^[[:space:]]*${key}[[:space:]]*=" "$CFG" \
        | head -n 1 \
        | sed -E 's/.*=[[:space:]]*"?([0-9]+)"?.*/\1/'
    )" || true

    if [[ -n "${val:-}" && "$val" =~ ^[0-9]+$ ]]; then
        echo "$val"
    else
        echo "nul"
    fi
}

HOTKEY_BUTTON=$(get_button 'input_enable_hotkey_btn')
LOAD_BUTTON=$(get_button 'input_load_state_btn')
SAVE_BUTTON=$(get_button 'input_save_state_btn')
SAVE_SLOT_INCREASE=$(get_button 'input_state_slot_increase_btn')
SAVE_SLOT_DECREASE=$(get_button 'input_state_slot_decrease_btn')

echo "${HOTKEY_BUTTON} ${LOAD_BUTTON} ${SAVE_BUTTON} ${SAVE_SLOT_INCREASE} ${SAVE_SLOT_DECREASE}"
