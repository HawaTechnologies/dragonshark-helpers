#!/usr/bin/env bash

# Usage:
#   set_resolution 1920 1080
#   set_resolution 1280 720
#   set_resolution 2048 1536 eDP-1
#
# Selection policy:
#   1. Exact resolution.
#   2. Same aspect ratio, closest resolution.
#   3. Closest aspect ratio + closest resolution.
#   4. On an effective tie, prefer the larger resolution.

set_resolution() {
    local target_w="$1"
    local target_h="$2"
    local output="${3:-${DRAGONSHARK_VIDEO_OUTPUT:-HDMI-1}}"

    if [[ -z "$target_w" || -z "$target_h" ]]; then
        echo "Usage: set_resolution <width> <height> [output]" >&2
        return 1
    fi

    if ! [[ "$target_w" =~ ^[0-9]+$ && "$target_h" =~ ^[0-9]+$ ]]; then
        echo "Invalid resolution: ${target_w}x${target_h}" >&2
        return 1
    fi

    #
    # Make sure the selected output exists and is connected.
    #
    if ! xrandr | grep -q "^${output} connected"; then
        echo "Output ${output} is not connected." >&2
        return 1
    fi

    local candidate_modes

    candidate_modes="$(
        xrandr |
        awk \
            -v output="$output" \
            -v tw="$target_w" \
            -v th="$target_h" '
            #
            # Find the selected output section.
            #
            $1 == output && $2 == "connected" {
                active = 1
                next
            }

            #
            # Another output begins -> selected output section ended.
            #
            active && /^[^[:space:]]/ {
                exit
            }

            #
            # Resolution lines look like:
            #
            #    1920x1080     60.00*+  59.94
            #
            active && $1 ~ /^[0-9]+x[0-9]+$/ {
                mode = $1

                split(mode, dimensions, "x")

                w = dimensions[1] + 0
                h = dimensions[2] + 0

                #
                # Aspect ratio comparison without floating-point equality:
                #
                #     w / h == tw / th
                #
                # iff:
                #
                #     w * th == tw * h
                #
                same_aspect = (w * th == tw * h)

                #
                # Relative dimensional error.
                #
                # Using relative rather than absolute differences makes
                # width and height comparable.
                #
                dw = (w - tw) / tw
                dh = (h - th) / th

                size_error = dw * dw + dh * dh

                #
                # Relative aspect-ratio error.
                #
                target_ratio = tw / th
                ratio = w / h

                ratio_error = ratio / target_ratio - 1

                if (ratio_error < 0)
                    ratio_error = -ratio_error

                #
                # Selection category:
                #
                #   0 = exact resolution
                #   1 = exact aspect ratio
                #   2 = different aspect ratio
                #
                if (w == tw && h == th)
                    category = 0
                else if (same_aspect)
                    category = 1
                else
                    category = 2

                #
                # Within category 2, strongly favor aspect-ratio
                # similarity, but still take resolution distance
                # into account.
                #
                if (same_aspect)
                    score = size_error
                else
                    score = ratio_error * 10 + size_error

                area = w * h
                printf "%d %.12f %d %s\n", category, score, -area, mode
            }
        ' |
        sort -k1,1n -k2,2n -k3,3n |
        awk '{ print $4 }'
    )"

    if [[ -z "$candidate_modes" ]]; then
        echo "No usable modes found for ${output}." >&2
        return 1
    fi

    local mode

    while IFS= read -r mode; do
        if [[ -z "$mode" ]]; then
            continue
        fi

        if [[ "$mode" == "${target_w}x${target_h}" ]]; then
            echo "Trying requested mode on ${output}: ${mode}."
        else
            echo "Trying fallback mode on ${output}: ${mode}."
        fi

        if xrandr --output "$output" --mode "$mode"; then
            echo "Set ${output} to ${mode}."
            return 0
        fi

        echo "Mode ${mode} failed, trying the next closest mode." >&2
    done <<< "$candidate_modes"

    echo "No candidate modes could be applied to ${output}." >&2
    return 1
}

set_resolution "$1" "$2" "$3"
