#!/bin/bash

if [ -z "$1" ]; then
    >&2 echo "Usage: set_volume <0-100>"
    exit 1
fi

pct=$1

if (( pct < 0 || pct > 100 )); then
    >&2 echo "Error: value must be between 0 and 100"
    exit 1
fi

# Convert to 0.0–1.0
val=$(awk -v pct=$pct 'BEGIN { printf "%.2f", pct / 100 }')
wpctl set-volume @DEFAULT_AUDIO_SINK@ "$val"
